{
	"name": "megajs",
	"version": "1.3.9",
	"description": "Unofficial JavaScript SDK for MEGA",
	"keywords": [
		"mega",
		"mega.co.nz",
		"mega.io",
		"mega.nz",
		"storage"
	],
	"homepage": "https://mega.js.org/",
	"license": "MIT",
	"author": "Tõnis Tiigi <tonistiigi@gmail.com>",
	"contributors": [
		"Gustavo Rodrigues (https://qgustavor.tk)"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/qgustavor/mega.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"provenance": true
	},
	"scripts": {
		"build": "node --experimental-strip-types build.ts && tsc",
		"test": "npm run check && node --experimental-strip-types test/helpers/test-runner.ts",
		"format": "oxfmt",
		"lint": "oxlint",
		"check": "oxlint && oxfmt --check"
	},
	"dependencies": {},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"esbuild": "^0.28.2",
		"mega-mock": "^0.4.2",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"typescript": "^6.0.3"
	}
}
